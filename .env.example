# Copy to .env (gitignored) and fill in real keys. Never commit .env.
# All keys are read via src/presale/config.py (pydantic-settings).

# MOLIT / data.go.kr service key (분양권전매 실거래가 API)
MOLIT_API_KEY=

# Bank of Korea ECOS API key (macro series)
ECOS_API_KEY=

# Geocoding: use VWorld OR Kakao (only one required)
VWORLD_API_KEY=
KAKAO_REST_API_KEY=

# Applyhome (청약홈) service key — inference list only
APPLYHOME_API_KEY=

# MLflow tracking (local SQLite backend + local artifact dir)
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_ARTIFACT_ROOT=./mlartifacts
