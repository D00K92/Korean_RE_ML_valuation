# Copy to .env (gitignored) and fill in. NEVER commit real values.
# Loaded by python-dotenv in data_pipeline/config.py; access via
# get_settings().secrets.<name>. Check what's set with Secrets.missing_keys()
# (returns key NAMES only — safe to print, never the values).

# --- Korean gov / open-data API keys (data pillar ingestion) ------------------
MOLIT_API_KEY=          # data.go.kr — 분양권/입주권 전매 + 아파트 매매 실거래가 (label + comps)
ECOS_API_KEY=           # ecos.bok.or.kr — Bank of Korea macro series
VWORLD_API_KEY=         # api.vworld.kr — geocoding (address -> lat/lon)
KAKAO_REST_API_KEY=     # dapi.kakao.com — geocoding fallback (keyword search)
APPLYHOME_API_KEY=      # api.odcloud.kr — 청약홈 분양정보 (launch-time enrichment)
NEIS_API_KEY=           # open.neis.go.kr — school locations
SCHOOLINFO_API_KEY=     # schoolinfo.go.kr — 학군 quality (졸업생 진로)

# --- GCP config (env-overrides for config.yaml; NOT secrets) ------------------
# Credentials themselves use Application Default Credentials — set
# GOOGLE_APPLICATION_CREDENTIALS to a service-account key PATH (never a value).
GOOGLE_APPLICATION_CREDENTIALS=./secrets/gcp-sa.json
GCP_PROJECT_ID=         # overrides config.yaml gcp.project
GCS_BUCKET=             # overrides config.yaml gcs.bucket (raw Parquet lake mirror)
BQ_DATASET=             # overrides config.yaml bigquery.dataset (default korea_real_estate)
VERTEX_PIPELINE_ROOT=   # gs://<bucket>/pipeline-root — required to submit the Vertex pipeline
ML_PIPELINE_IMAGE=      # container image (with this repo installed) for KFP components
