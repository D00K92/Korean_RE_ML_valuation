.venv/
__pycache__/
*.py[cod]
*.egg-info/
.DS_Store
.env
*.key
# GCP service-account keys — mounted into Airflow, never committed
secrets/
*-sa.json
*.json.key
.claude/

# no local data/ lake — all data is queried from GCS/BigQuery; reference lookups
# are GCS-backed (gs://<bucket>/reference/) and cached under .cache/ (below)
data/

# ml / pipeline artifacts
*.parquet
*.pkl
*_pipeline.json        # compiled KFP/Vertex pipeline spec (build artifact)

# astro / local airflow
.astro/
# Astro scaffolds ./dags and ./tests at root, but our DAGs live in
# data_pipeline/dags (DAGS_FOLDER is repointed there) and DAG tests in
# data_pipeline/tests. Ignore the root scaffolds so they never re-clutter the repo.
/dags/
/tests/

# cloud-backed reference cache (fetched from gs://<bucket>/reference/)
.cache/

# airflow
logs/
airflow.db
airflow.cfg
standalone_admin_password.txt

*.log
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/
